TELEGRAM_TOKEN=123456789:ABCDEF_your_telegram_bot_token
# Optional for webhook deployment on Railway. Example: https://your-service.up.railway.app
WEBHOOK_BASE=https://<railway-service-domain>
# Optional: used to verify Telegram webhook signature
# Allowed: 1-256 chars of A–Z, a–z, 0–9 and underscore only.
# Example:
SECRET_TOKEN=YourSecretToken_1234567890
# Railway provides PORT automatically. You can override for local webhook testing.
PORT=8080
