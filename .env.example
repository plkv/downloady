TELEGRAM_TOKEN=123456789:ABCDEF_your_telegram_bot_token
# Optional for webhook deployment on Railway. Example: https://your-service.up.railway.app
WEBHOOK_BASE=https://<railway-service-domain>
# Optional: used to verify Telegram webhook signature
# Allowed: 1-256 chars of A–Z, a–z, 0–9 and underscore only.
# Example:
SECRET_TOKEN=YourSecretToken_1234567890
# Railway provides PORT automatically. You can override for local webhook testing.
PORT=8080

# Behavior and performance tuning
# Max size (in MB) for local download+upload fallback. Telegram Bot API limit ~50MB.
MAX_UPLOAD_MB=48
# Parallel downloads for media groups (fallback path)
DOWNLOAD_CONCURRENCY=3
# Force never downloading locally (only send remote URLs)
FORCE_DIRECT_ONLY=false
# Domains to always use local download+upload (reliable for CDNs): comma-separated
ALWAYS_FALLBACK_DOMAINS=instagram.com,x.com,twitter.com,pinterest.com,linkedin.com
# Logging level: DEBUG/INFO/WARN/ERROR
LOG_LEVEL=INFO

# Optional: cookies for LinkedIn extractor (base64 of Netscape cookies.txt containing only linkedin.com entries)
# How to get: install "Get cookies.txt" extension, export cookies for linkedin.com, then base64-encode the file
# and paste here. Example (macOS): base64 -w0 cookies.txt
LINKEDIN_COOKIES_B64=
